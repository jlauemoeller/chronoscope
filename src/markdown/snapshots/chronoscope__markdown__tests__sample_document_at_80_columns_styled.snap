─────────┼──────────────────────────────────────┼────────────                   
parser   │ Turns markdown into blocks           │ done                          
renderer │ Lays the blocks out as wrapped lines │ in progress                   
                                                                                
  // Say hello.                                                                 
  fn main() {                                                                   
      let answer = 42;                                                          
      println!("The answer is {answer}, printed from main with a long line");   
  }                                                                             
                                                                                
